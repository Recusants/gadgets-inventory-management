# ============================================================
# Gadget Store System — Environment Configuration
# ============================================================

# Django Core Security
DJANGO_SECRET_KEY=generate_a_secure_secret_key_here
SECRET_KEY=generate_a_secure_secret_key_here
DEBUG=False
ALLOWED_HOSTS=*
HTTP_PORT=8086
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8086,http://localhost:8086

# Docker Registry Configuration
DOCKER_REGISTRY=tinashemp
TAG=latest

# ============================================================
# Production Database (PostgreSQL 16 in Docker Compose Prod)
# ============================================================
DB_NAME=twentyone_void_prod_db
DB_USER=twentyone_user
DB_PASSWORD=change_this_secure_password
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=twentyone_void_prod_db
POSTGRES_USER=twentyone_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================================
# Development Environments (Docker Dev & Env Dev with PostgreSQL)
# ============================================================
DEV_DB_NAME=gadget_store_dev_db
DEV_DB_USER=gadget_dev_user
DEV_DB_PASSWORD=dev_password
DEV_DB_PORT=5433
DEV_HTTP_PORT=8001

# Sentry Error Tracking & Performance Monitoring (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
