# 21 Void Technologies - Environment Configuration
DJANGO_SECRET_KEY=generate_a_secure_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
HTTP_PORT=8086
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8086,http://localhost:8086

# Database (PostgreSQL 16)
POSTGRES_DB=twentyone_void_prod_db
POSTGRES_USER=twentyone_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Sentry Error Tracking & Performance Monitoring
# Paste your Sentry DSN (from Sentry Project Settings -> Client Keys (DSN))
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0
# Alternatively: SENTRY_KEY=https://your-public-key@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

