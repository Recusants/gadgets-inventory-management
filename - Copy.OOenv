# 21 Void Technologies - Environment Configuration
DJANGO_SECRET_KEY=local-dev-secret-key-21void-tech-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*
HTTP_PORT=8086
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8086,http://localhost:8086

# Database (PostgreSQL 16 for Docker / Production)
POSTGRES_DB=twentyone_void_prod_db
POSTGRES_USER=twentyone_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Sentry Error Tracking & Performance Monitoring
# Paste your Sentry DSN key here:
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.2
